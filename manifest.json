{
    "manifest_version": 3,
    "name": "Office Security Shield",
    "version": "1.5",
    "description": "Centralized secure website restriction extension for office environment.",
    "permissions": [
        "tabs"
        
    ],
    "host_permissions": [
        "<all_urls>"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "icons": {
        "16": "icon16.png",
        "48": "icon48.png",
        "128": "icon128.png"
    },
    "action": {
        "default_popup": "popup.html"
    }
}
